<Window x:Class="YandexMusicController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yandex Music Controller"
        Height="700" Width="980"
        MinHeight="600" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}"
        Foreground="{StaticResource TextMain}"
        FontFamily="Segoe UI">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Margin="0,0,0,18">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <Border Width="8" Height="22" Background="{StaticResource Accent}" CornerRadius="3" Margin="0,0,10,0" VerticalAlignment="Center"/>
          <TextBlock Text="Yandex Music Controller" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="Локальный пульт управления через медиасеансы Windows"
                   Foreground="{StaticResource TextMuted}" Margin="18,6,0,0" FontSize="13"/>
      </StackPanel>

      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="NavPlayerBtn"
                Content="Плеер"
                Click="NavPlayer_Click"
                Padding="18,10"
                Margin="4"/>
        <Button x:Name="NavHistoryBtn"
                Content="История"
                Style="{StaticResource GhostButton}"
                Click="NavHistory_Click"
                Padding="18,10"
                Margin="4,4,0,4"/>
      </StackPanel>
    </DockPanel>

    <Grid x:Name="PlayerView" Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.25*"/>
        <ColumnDefinition Width="0.9*"/>
      </Grid.ColumnDefinitions>

      <Border Background="{StaticResource PanelBg}"
              CornerRadius="18"
              Padding="26"
              Margin="0,0,12,0"
              BorderBrush="{StaticResource BorderSubtle}"
              BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <StackPanel>
            <TextBlock Text="СЕЙЧАС ИГРАЕТ" Style="{StaticResource SectionLabel}"/>
            <TextBlock x:Name="TrackTitle"
                       Text="Ожидание медиасеанса…"
                       FontSize="28"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       Margin="0,16,0,6"
                       LineHeight="34"/>
            <TextBlock x:Name="TrackArtist"
                       Text="Запустите Яндекс Музыку и начните воспроизведение"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="16"
                       TextWrapping="Wrap"/>
            <Border Style="{StaticResource StatusChip}" HorizontalAlignment="Left" Margin="0,16,0,0">
              <TextBlock x:Name="PlaybackStatus"
                         Text="Нет активного сеанса"
                         Foreground="{StaticResource TextMuted}"
                         FontSize="13"/>
            </Border>
          </StackPanel>

          <StackPanel Grid.Row="2"
                      Orientation="Horizontal"
                      HorizontalAlignment="Center"
                      Margin="0,28,0,4">
            <Button Content="⏮  Предыдущий"
                    Click="Previous_Click"
                    Style="{StaticResource GhostButton}"
                    Padding="18,12"
                    MinWidth="130"/>
            <Button Content="▶  /  ⏸"
                    Click="PlayPause_Click"
                    FontSize="16"
                    Padding="26,12"
                    MinWidth="110"
                    Margin="10,4"/>
            <Button Content="Следующий  ⏭"
                    Click="Next_Click"
                    Style="{StaticResource GhostButton}"
                    Padding="18,12"
                    MinWidth="130"/>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="1"
              Background="{StaticResource PanelBg}"
              CornerRadius="18"
              Padding="22"
              Margin="12,0,0,0"
              BorderBrush="{StaticResource BorderSubtle}"
              BorderThickness="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="ГОРЯЧИЕ КЛАВИШИ" Style="{StaticResource SectionLabel}"/>

            <Border Background="{StaticResource PanelBgElevated}" CornerRadius="12" Padding="14,12" Margin="0,14,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Предыдущий трек" FontWeight="SemiBold" FontSize="13"/>
                  <TextBlock Text="Ctrl + Alt + ←" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#2A3140" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                  <TextBlock Text="←" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                </Border>
              </Grid>
            </Border>

            <Border Background="{StaticResource PanelBgElevated}" CornerRadius="12" Padding="14,12" Margin="0,8,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Следующий трек" FontWeight="SemiBold" FontSize="13"/>
                  <TextBlock Text="Ctrl + Alt + →" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#2A3140" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                  <TextBlock Text="→" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                </Border>
              </Grid>
            </Border>

            <Border Background="{StaticResource PanelBgElevated}" CornerRadius="12" Padding="14,12" Margin="0,8,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Play / Pause" FontWeight="SemiBold" FontSize="13"/>
                  <TextBlock Text="Ctrl + Alt + Пробел" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#2A3140" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                  <TextBlock Text="␣" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                </Border>
              </Grid>
            </Border>

            <Border Height="1" Background="{StaticResource BorderSubtle}" Margin="0,20,0,16"/>

            <TextBlock Text="СОСТОЯНИЕ" Style="{StaticResource SectionLabel}"/>
            <Border Style="{StaticResource StatusChip}" Margin="0,10,0,0">
              <TextBlock x:Name="HotkeyStatus"
                         Text="Регистрация…"
                         Foreground="{StaticResource Success}"
                         FontSize="12"
                         TextWrapping="Wrap"/>
            </Border>
            <Border Style="{StaticResource StatusChip}">
              <TextBlock x:Name="MediaSourceStatus"
                         Text="Подключение к медиасеансам…"
                         Foreground="{StaticResource TextMuted}"
                         FontSize="12"
                         TextWrapping="Wrap"/>
            </Border>

            <TextBlock Text="Управление идёт через системные медиасеансы Windows."
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextDim}"
                       FontSize="12"
                       Margin="0,14,0,0"
                       LineHeight="18"/>

            <CheckBox x:Name="StartupCheck"
                      Content="Запускать вместе с Windows"
                      Margin="2,18,0,0"
                      Checked="StartupCheck_Changed"
                      Unchecked="StartupCheck_Changed"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Grid x:Name="HistoryView" Grid.Row="1" Visibility="Collapsed">
      <Border Background="{StaticResource PanelBg}"
              CornerRadius="18"
              BorderBrush="{StaticResource BorderSubtle}"
              BorderThickness="1"
              Padding="8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <DockPanel Margin="12,10,12,8">
            <TextBlock x:Name="HistorySummary"
                       Text="Загрузка…"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="13"
                       VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Content="Недавние" Style="{StaticResource GhostButton}" Click="HistorySortRecent_Click" Padding="12,7" FontSize="12"/>
              <Button Content="По прослушиваниям" Style="{StaticResource GhostButton}" Click="HistorySortPlays_Click" Padding="12,7" FontSize="12"/>
              <Button Content="По времени" Style="{StaticResource GhostButton}" Click="HistorySortTime_Click" Padding="12,7" FontSize="12"/>
              <Button Content="Обновить" Style="{StaticResource GhostButton}" Click="HistoryRefresh_Click" Padding="12,7" FontSize="12"/>
            </StackPanel>
          </DockPanel>

          <DataGrid x:Name="HistoryGrid"
                    Grid.Row="1"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserAddRows="False"
                    CanUserResizeRows="False"
                    HeadersVisibility="Column"
                    GridLinesVisibility="Horizontal"
                    HorizontalGridLinesBrush="#1E2430"
                    Background="Transparent"
                    Foreground="{StaticResource TextMain}"
                    RowBackground="Transparent"
                    AlternatingRowBackground="#141820"
                    BorderThickness="0"
                    RowHeight="38"
                    Margin="8,0,8,8">
            <DataGrid.ColumnHeaderStyle>
              <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="10,10"/>
                <Setter Property="BorderThickness" Value="0"/>
              </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.CellStyle>
              <Style TargetType="DataGridCell">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Style.Triggers>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2A3140"/>
                    <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                  </Trigger>
                </Style.Triggers>
              </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Трек" Binding="{Binding Title}" Width="2.2*"/>
              <DataGridTextColumn Header="Исполнитель" Binding="{Binding Artist}" Width="2*"/>
              <DataGridTextColumn Header="Прослушиваний" Binding="{Binding PlayCount}" Width="120"/>
              <DataGridTextColumn Header="Общее время" Binding="{Binding TotalTime}" Width="130"/>
              <DataGridTextColumn Header="Последний раз" Binding="{Binding LastPlayedLocal}" Width="150"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
    </Grid>

    <DockPanel Grid.Row="2" Margin="0,18,0,0">
      <TextBlock x:Name="FooterStatus"
                 Text="Готово"
                 Foreground="{StaticResource TextDim}"
                 FontSize="12"
                 VerticalAlignment="Center"/>
      <Button DockPanel.Dock="Right"
              Content="Свернуть в трей"
              Click="MinimizeToTray_Click"
              Style="{StaticResource GhostButton}"
              Padding="14,9"/>
    </DockPanel>
  </Grid>
</Window>
