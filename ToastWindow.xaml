<Window x:Class="YandexMusicController.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Track Toast"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowActivated="False">
  <Border x:Name="RootBorder"
          Background="#F0171B22"
          BorderBrush="#55FFCC00"
          BorderThickness="1"
          CornerRadius="14"
          Padding="18,14"
          MinWidth="300"
          MaxWidth="400"
          Opacity="0">
    <Border.Effect>
      <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
    </Border.Effect>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Width="4" Background="#FFCC00" CornerRadius="2" Margin="0,0,14,0" VerticalAlignment="Stretch"/>
      <StackPanel Grid.Column="1">
        <TextBlock Text="СЕЙЧАС ИГРАЕТ"
                   FontSize="10"
                   FontWeight="Bold"
                   Foreground="#FFCC00"
                   Margin="0,0,0,6"/>
        <TextBlock x:Name="TitleText"
                   Text="Трек"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Foreground="#F3F4F6"
                   TextWrapping="Wrap"
                   MaxWidth="340"/>
        <TextBlock x:Name="ArtistText"
                   Text="Исполнитель"
                   FontSize="13"
                   Foreground="#9AA3B2"
                   TextWrapping="Wrap"
                   MaxWidth="340"
                   Margin="0,3,0,0"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
