<Application x:Class="YandexMusicController.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <!-- Palette -->
    <SolidColorBrush x:Key="WindowBg" Color="#0E1116"/>
    <SolidColorBrush x:Key="PanelBg" Color="#171B22"/>
    <SolidColorBrush x:Key="PanelBgElevated" Color="#1E2430"/>
    <SolidColorBrush x:Key="Accent" Color="#FFCC00"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#33FFCC00"/>
    <SolidColorBrush x:Key="TextMain" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="TextMuted" Color="#9AA3B2"/>
    <SolidColorBrush x:Key="TextDim" Color="#6B7380"/>
    <SolidColorBrush x:Key="BorderSubtle" Color="#2A3140"/>
    <SolidColorBrush x:Key="Success" Color="#6BCB8A"/>
    <SolidColorBrush x:Key="Danger" Color="#E57373"/>

    <!-- Primary accent button -->
    <Style x:Key="AccentButton" TargetType="Button">
      <Setter Property="Foreground" Value="#111318"/>
      <Setter Property="Background" Value="#FFCC00"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="Margin" Value="4"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    CornerRadius="10"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FFD633"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#E6B800"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Ghost / secondary button -->
    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Foreground" Value="#F3F4F6"/>
      <Setter Property="Background" Value="#1E2430"/>
      <Setter Property="BorderBrush" Value="#2A3140"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,9"/>
      <Setter Property="Margin" Value="4"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#2A3140"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#3A4354"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#151A22"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Default buttons use accent style -->
    <Style TargetType="Button" BasedOn="{StaticResource AccentButton}"/>

    <!-- Checkbox -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- Section label -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Accent}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>

    <!-- Status chip -->
    <Style x:Key="StatusChip" TargetType="Border">
      <Setter Property="Background" Value="#1E2430"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
  </Application.Resources>
</Application>
